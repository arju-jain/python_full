# Django Core Configuration
DEBUG=True
SECRET_KEY=django-insecure-multivendor-premium-change-in-production-key-xyz987
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL primary)
DB_ENGINE=postgresql
DB_NAME=multivendor_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Set to True to use SQLite for local offline testing if PostgreSQL is unavailable
USE_SQLITE=False

# Marketplace Settings
MARKETPLACE_NAME="AURA LUXE"
MARKETPLACE_COMMISSION_PERCENT=10.0
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹

# Razorpay Test Credentials (replace with your Razorpay Test API keys)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Media & Static
MEDIA_URL=/media/
STATIC_URL=/static/
